# Copy to .env and adjust as needed. All variables are optional -- sane
# defaults are baked into harness/core/config.py. Every var is prefixed
# HARNESS_ and maps 1:1 to a field on the Settings class there.

# --- Persistence ---
# SQLite (default, zero setup):
HARNESS_DATABASE_URL=sqlite+aiosqlite:///./data/harness.db
# Postgres (real deployment):
# HARNESS_DATABASE_URL=postgresql+asyncpg://harness:harness@db:5432/harness

# --- Sandbox defaults (overridable per agent version at registration) ---
HARNESS_DEFAULT_CPU_SECONDS=5
HARNESS_DEFAULT_MEMORY_MB=256
HARNESS_DEFAULT_TIMEOUT_SECONDS=30
HARNESS_DEFAULT_PID_LIMIT=32

# --- Concurrency ---
HARNESS_MAX_CONCURRENT_SESSIONS_PER_AGENT=3
HARNESS_MAX_CONCURRENT_SESSIONS_TOTAL=50

# --- Approval ---
HARNESS_APPROVAL_DEFAULT_TIMEOUT_SECONDS=600

# --- Authentication / authorization ---
# One static API key per role, sent as the `X-API-Key` header. These
# dev defaults are safe to use locally but MUST be overridden before any
# non-local deployment -- the app logs a startup warning if they aren't.
HARNESS_API_KEY_ADMIN=dev-admin-key-***CHANGE-ME***
HARNESS_API_KEY_OPERATOR=dev-operator-key-***CHANGE-ME***
HARNESS_API_KEY_AUDITOR=dev-auditor-key-***CHANGE-ME***
HARNESS_API_KEY_CLIENT=dev-client-key-***CHANGE-ME***

# --- CORS (comma-separated origins allowed to call this API) ---
HARNESS_CORS_ALLOW_ORIGINS_CSV=http://localhost:5173,http://127.0.0.1:5173

# --- Container runtime (only used by agents registered with
#     runtime_kind: container -- requires a reachable Docker daemon) ---
HARNESS_CONTAINER_RUNTIME_NETWORK=none
